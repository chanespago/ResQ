{
  "expo": {
    "name": "RESQ",
    "slug": "resq",
    "scheme": "resq",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-asset",
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": false,
          "recordAudioAndroid": false,
          "microphonePermission": false
        }
      ],
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow RESQ to share your location when you activate SOS."
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Allow RESQ to import emergency contacts you select."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#080809",
          "imageWidth": 160
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.resq.safety"
    },
    "android": {
      "package": "com.resq.safety",
      "versionCode": 3,
      "permissions": [
        "VIBRATE"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "023ba0ee-136d-4b28-b922-d6801c78bbe3"
      }
    }
  }
}
