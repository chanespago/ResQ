{
  "expo": {
    "name": "ResQ",
    "slug": "resq",
    "scheme": "resq",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-asset",
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": false,
          "recordAudioAndroid": false,
          "microphonePermission": false
        }
      ],
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow ResQ to share your location when you activate SOS.",
          "locationAlwaysAndWhenInUsePermission": "Allow ResQ to share your location in the background for nearby SOS alerts. You can turn this off in Settings.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "expo-notifications",
      [
        "expo-contacts",
        {
          "contactsPermission": "Allow ResQ to import emergency contacts you select."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#080809",
          "imageWidth": 200
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.resq.safety"
    },
    "android": {
      "package": "com.resq.safety",
      "versionCode": 4,
      "permissions": [
        "VIBRATE"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/splash-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "023ba0ee-136d-4b28-b922-d6801c78bbe3"
      }
    }
  }
}
